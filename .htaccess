<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>

DirectoryIndex public/index.php
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^(?:bin|config|data|db|docs|src|storage|templates|tests|vendor)(?:/|$) - [F,L]
RewriteRule ^(?:\.env|\.git|composer\.(?:json|lock)|Dockerfile|Makefile|phpstan\.neon\.dist|phpunit\.xml\.dist|README\.md|SECURITY\.md)$ - [F,L]

# Disable ModSecurity for Chat & Feedback API endpoints (session-authenticated AJAX calls)
# NOTE: <LocationMatch> is NOT valid in .htaccess; use SecRule Ctl:ruleEngine instead
<IfModule mod_security2.c>
    SecRule REQUEST_URI "@beginsWith /api/chat" "id:10001,phase:1,pass,nolog,ctl:ruleEngine=Off"
    SecRule REQUEST_URI "@beginsWith /api/feedback" "id:10002,phase:1,pass,nolog,ctl:ruleEngine=Off"
    SecRule REQUEST_URI "@beginsWith /chat" "id:10003,phase:1,pass,nolog,ctl:ruleEngine=Off"
</IfModule>

RewriteRule ^$ public/index.php [QSA,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.+)$ public/$1 [QSA,L]
