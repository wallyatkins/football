# App Environment
APP_ENV=production
APP_URL=https://football.wallyatkins.com
APP_SECRET=change-this-to-a-secure-random-key

# Database Configuration
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multili2_football
DB_USER=multili2_football
DB_PASS=secret

# WallyAuth OIDC Integration
OIDC_ISSUER=https://auth.wallyatkins.com
OIDC_CLIENT_ID=football-pool
OIDC_CLIENT_SECRET=secret
OIDC_REDIRECT_URI=https://football.wallyatkins.com/auth/callback

# Commissioner Payment Handles
COMMISSIONER_VENMO=Wally-Atkins
COMMISSIONER_CASHAPP=WallyAtkins
ADMIN_EMAILS=wally@wallyatkins.com
